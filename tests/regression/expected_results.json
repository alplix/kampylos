{
  "synthetic": {
    "tolerances": {
      "chi2_abs": 1.0,
      "chi2_rel": 0.002
    },
    "cases": [
      {
        "name": "planet_log10",
        "what": "planet injected at log10 s=0.2, log10 q=-3; log10 WU over log10 q in {-5,-3,-1}",
        "photometry": "synthetic_planet.dat",
        "wus": [
          "flux 0.2 0.2 1 -5 -1 3 log10"
        ],
        "expect": {
          "grid": "log10",
          "best_log_s": 0.2,
          "best_log_q": -3.0,
          "min": {
            "delta_chi2": 300.0,
            "dchi2_robust": 200.0,
            "n_pts50": 4
          },
          "max": {
            "best_chi2": 480.0
          },
          "equal": {
            "flag_few_points": 0,
            "flag_poor_fit": 0
          }
        }
      },
      {
        "name": "planet_same_numbers_as_ln",
        "what": "the same cell numbers WITHOUT the marker = natural logs (s=1.22, q=0.05): must not reproduce the planet",
        "photometry": "synthetic_planet.dat",
        "wus": [
          "flux 0.2 0.2 1 -3 -3 1"
        ],
        "expect": {
          "grid": "ln",
          "cell_chi2_worse_than": [
            "planet_log10",
            100.0
          ]
        }
      }
    ]
  },
  "real": {
    "tolerances": {
      "chi2_abs": 2.0,
      "chi2_rel": 0.002
    },
    "cases": [
      {
        "name": "MOA-2003-BLG-004",
        "what": "Object-4 control: ~1300 delta-chi2 from 3 saturated peak points; must NOT be a candidate",
        "photometry": "MOA-2003-BLG-004.dat",
        "wus": [
          "flux 0.400000 0.400000 1 -1.666667 -1.666667 1 log10",
          "flux 0.200000 0.200000 1 -2.777778 -2.777778 1 log10",
          "flux 0.400000 0.400000 1 -1.111111 -1.111111 1 log10"
        ],
        "expect": {
          "grid": "log10",
          "equal": {
            "flag_few_points": 1,
            "flag_poor_fit": 0
          },
          "max": {
            "dchi2_robust": 0.0
          }
        }
      },
      {
        "name": "MOA-2002-BLG-014",
        "what": "Object-2 control: a dwarf nova, not microlensing -> poor_fit_any_model",
        "photometry": "MOA-2002-BLG-014.dat",
        "wus": [
          "flux 0.000000 0.000000 1 -1.111111 -1.111111 1 log10",
          "flux 0.000000 0.000000 1 -3.333333 -3.333333 1 log10",
          "flux -0.400000 -0.400000 1 -0.555556 -0.555556 1 log10"
        ],
        "expect": {
          "grid": "log10",
          "equal": {
            "flag_poor_fit": 1
          },
          "min": {
            "delta_chi2": 1000.0
          }
        }
      },
      {
        "name": "MOA-2003-BLG-004-legacy-ln-cells",
        "what": "bug 4: four legacy natural-log cells (no marker) where the old grid ended WORSE than the single lens although the binary can mimic it (s=0.57 q=0.018, s=2.18 q=0.069, s=2.72 q=0.169, s=0.37 q=0.108); the new seeding must reach the single-lens chi2",
        "photometry": "MOA-2003-BLG-004.dat",
        "wus": [
          "flux -0.555556 -0.555556 1 -4.000000 -4.000000 1",
          "flux 0.777778 0.777778 1 -2.666667 -2.666667 1",
          "flux 1.000000 1.000000 1 -1.777778 -1.777778 1",
          "flux -1.000000 -1.000000 1 -2.222222 -2.222222 1"
        ],
        "expect": {
          "grid": "ln",
          "equal": {
            "n_cells_worse_than_single": 0
          }
        }
      },
      {
        "name": "OB120026",
        "what": "OGLE-2012-BLG-0026, two planets q=1.3e-4 / 7.8e-4 (log10 q -3.89 / -3.11), s~1.03: the published cell must win with a huge delta-chi2; in the OGLE-only file the anomaly is carried by 2 consecutive points (HJD 2455989.83/.87), so few_points_signal is the expected (conservative) verdict",
        "photometry": "ogle-2012-blg-0026/phot.dat",
        "wus": [
          "mag 0.000000 0.000000 1 -3.888889 -3.888889 1 log10",
          "mag 0.000000 0.000000 1 -3.333333 -3.333333 1 log10"
        ],
        "expect": {
          "grid": "log10",
          "best_log_q": -3.888889,
          "best_log_s": 0.0,
          "min": {
            "delta_chi2": 5000.0
          },
          "equal": {
            "flag_few_points": 1
          }
        }
      },
      {
        "name": "OB150966",
        "what": "OGLE-2015-BLG-0966, planet q=1.7e-4 (log10 q -3.77), s~1",
        "photometry": "ogle-2015-blg-0966/phot.dat",
        "wus": [
          "mag 0.000000 0.000000 1 -3.888889 -3.888889 1 log10"
        ],
        "expect": {
          "grid": "log10",
          "min": {
            "delta_chi2": 50.0
          }
        }
      },
      {
        "name": "OB171522",
        "what": "OGLE-2017-BLG-1522 (q~0.016, s~0.85): the planetary anomaly was covered by KMTNet, the OGLE file has 4 points on the peak -> no robust signal expected from OGLE alone",
        "photometry": "ogle-2017-blg-1522/phot.dat",
        "wus": [
          "mag 0.000000 0.000000 1 -1.666667 -1.666667 1 log10"
        ],
        "expect": {
          "grid": "log10",
          "max": {
            "delta_chi2": 100.0
          },
          "equal": {
            "flag_poor_fit": 0
          }
        }
      }
    ]
  }
}