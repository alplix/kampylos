+    double C = 0, FC = 0, T = 0, FT = 0, nfs = 0;
+    for (size_t i = 0; i < n_done; i++) { C += cost[i]; T += tim[i]; if (cost[i] > 1) { FC += cost[i]; FT += tim[i]; nfs++; } }
+    s.n[k]++; s.cost[k] += C; s.fscost[k] += FC; s.tim[k] += T; s.fstim[k] += FT; s.nfs[k] += nfs;
+    bool rejected = v >= cutoff;
+    s.rej[k] += rejected;
+    if (n_done < data.size() || cutoff >= 1e299) return;   // invalid candidate (1e18) or a value that is always stored
+    double sw = 0, swy = 0;
+    for (const auto& d : data) { double w = 1 / (d.sigma * d.sigma); sw += w; swy += w * d.flux; }
+    const double c = swy / sw;
+    auto add = [&](size_t i, double* S) {
+        double w = 1 / (data[i].sigma * data[i].sigma), A = mag[i], y = data[i].flux - c;
+        S[0] += w * A * A; S[1] += w * A; S[2] += w; S[3] += w * A * y; S[4] += w * y; S[5] += w * y * y;
+    };
+    auto lb = [&](const double* S) { return kampylos_censor_bound(S[0], S[1], S[2], S[3], S[4], S[5]); };
+    {   // cheap first
+        double S[6] = {};
+        for (size_t i = 0; i < data.size(); i++) if (cost[i] <= 1) add(i, S);
+        double rest = FC, trest = FT;
+        bool stop = lb(S) >= thr;
+        for (size_t i = 0; !stop && i < data.size(); i++) {
