+            add(i, S); rest -= cost[i]; trest -= tim[i];
+            stop = lb(S) >= thr;
+        }
+        if (stop) { s.skip_cf[k] += rest; s.tskip_cf[k] += trest; if (!rejected) s.violations++; }
+    }
+    {   // time order
+        double S[6] = {}, rest = C, trest = T;
+        for (size_t i = 0; i < data.size(); i++) {
+            add(i, S); rest -= cost[i]; trest -= tim[i];
+            if (lb(S) >= thr) { s.skip_to[k] += rest; s.tskip_to[k] += trest; if (!rejected) s.violations++; break; }
+        }
+    }
+}
 
