+// Least-squares chi2 of the six weighted sums (flux centred), 0 when (fs, fb) are not determined.
+inline double kampylos_censor_bound(double AA, double A1, double S11, double Ay, double S1y, double yy) {
+    double diag = AA * S11, det = diag - A1 * A1;
+    if (!(diag > 0) || !(det > 1e-8 * diag)) return 0;
+    double fs = (S11 * Ay - A1 * S1y) / det, fb = (AA * S1y - A1 * Ay) / det;
+    double lb = yy - fs * Ay - fb * S1y;
+    return std::isfinite(lb) && lb > 0 ? lb : 0;
+}
+inline void kampylos_censor_record(const std::vector<DataPoint>& data, const std::vector<double>& mag,
+                                   const std::vector<double>& cost, const std::vector<double>& tim, size_t n_done, double v) {
